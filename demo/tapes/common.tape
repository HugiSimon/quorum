# Shared look for every recording: the palette of the app, on the app's own background.
# Sourced by each tape, so a change to the frame is made once.

Set Shell "bash"
Set FontFamily "IBM Plex Mono"
Set FontSize 17
Set Padding 24
Set Margin 0
Set TypingSpeed 45ms
Set Framerate 24
Set PlaybackSpeed 1.0
Set Theme { "background": "#0c0b0a", "foreground": "#d9d3c8", "cursor": "#e8b563", "selection": "#2b2824", "black": "#0c0b0a", "red": "#d96b6b", "green": "#7fbf6a", "yellow": "#e8b563", "blue": "#7abdff", "magenta": "#c9a3f5", "cyan": "#3bcfcf", "white": "#d9d3c8", "brightBlack": "#56514a", "brightRed": "#d96b6b", "brightGreen": "#7fbf6a", "brightYellow": "#e8b563", "brightBlue": "#7abdff", "brightMagenta": "#c9a3f5", "brightCyan": "#3bcfcf", "brightWhite": "#ffffff" }
